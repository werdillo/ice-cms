{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ice-cms-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "cms-bucket"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    "R2_PUBLIC_BASE_URL": "https://pub-faacf66cb3a14c74a63b8dee80132038.r2.dev"
  },

  "dev": {
    "port": 8000
  },

  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "R2_PUBLIC_BASE_URL": "https://pub-faacf66cb3a14c74a63b8dee80132038.r2.dev"
      },
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "cms-bucket"
        }
      ]
    }
  }
}
